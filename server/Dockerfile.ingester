# Caddy access log → Postgres ingester sidecar.
#
# Same Deno base as the mcp server (server/Dockerfile) so we don't pull
# a second image into the homelab. Different entrypoint (log_ingester.ts).
#
# This image only starts in Pattern B (gated by the `pattern-b` profile in
# docker-compose.pattern-b.yml). Pattern A doesn't run Caddy, so the access
# log files don't exist and there'd be nothing to ingest.

FROM denoland/deno:2.9.4

WORKDIR /app

# --frozen: see server/Dockerfile — ship exactly the lockfile-resolved graph.
# postgres_deferred_patched.ts rides in this layer because the import map
# remaps the driver's utils/deferred.ts to it — `deno install` fails to
# resolve the graph without the file present (see server/Dockerfile).
COPY deno.json deno.lock postgres_deferred_patched.ts ./
RUN deno install --frozen

# Copy ALL .ts files so cross-module imports resolve at build time.
# Note: log_ingester.ts deliberately does NOT import ./config.ts (see
# the comment at log_ingester.ts:33-37) — config.ts enforces the
# tri-state AUTH0_* validation and other mcp-specific contracts the
# ingester shouldn't be subject to. The ingester DOES import ./inet.ts
# for the parseInetCandidate helper (shared with auth.ts/auth_audit.ts);
# any future shared helpers added here are likewise free to be imported
# without dragging config.ts in.
COPY *.ts ./

# Cache + type-check at build time.
RUN deno cache --check --frozen log_ingester.ts

# Pre-create the cursor mount-point directory while we still have root +
# a writable rootfs. The container runs with `read_only: true` (per the pre-exposure host audit
# hardening), so Docker can't `mkdirat` the mountpoint at container init
# — it has to exist in the image. The chown lets the `deno` user
# (UID 1000) own the directory so it can write cursor files into the
# bind-mounted volume's empty contents on first start.
USER root
RUN mkdir -p /var/lib/ingester/cursors && chown -R deno:deno /var/lib/ingester

USER deno

# No HEALTHCHECK — the ingester is a polling loop with no HTTP surface.
# `docker compose ps` will show it as "running" or restart-looping if it
# can't connect to postgres.

# Deno permissions:
# --allow-net  built from DB_HOST:DB_PORT at container start (see the `sh -c`
#              wrapper in CMD — exec-form CMD does not expand env). The ingester
#              only ever talks to the configured database: the bundled
#              `postgres:5432` by default, or the external DB address when
#              DB_HOST is set (e.g. a dedicated DB qube). Kept SCOPED rather than
#              dropped to unrestricted `--allow-net` like mcp, so a compromised
#              ingester still can't reach the outside world.
#              UNIX-SOCKET DB_HOST (an absolute path — the ingress qube's local
#              log sink) is ALSO a --allow-net permission, not a filesystem
#              one: Deno describes a unix connect as `unix:<socket path>` and
#              requires --allow-net for it, on top of --allow-read AND
#              --allow-write on the path (all three, verified against Deno
#              2.9; read-and-write alone fails with "Requires net access to
#              unix:…"). The scope is enforced — a `unix:` value naming a
#              different path is rejected — so the socket branch grants exactly
#              one socket file and NO TCP host whatsoever, which is strictly
#              tighter than the TCP branch it replaces.
#              DB_HOST itself should be the socket DIRECTORY — the contract
#              dbHostType() in log_ingester.ts documents, and the shape every
#              env example ships. The grant still lists both spellings
#              because the driver stats the path and branches
#              (#openSocketConnection): a directory gets `.s.PGSQL.$DB_PORT`
#              appended, while a path that stats as a FILE is connected to
#              as-is — the grant tracks the driver's reach, not just the
#              documented convention.
#              The compose service additionally runs `network_mode: none`, so
#              the container has no network stack to reach even if this grant
#              were wider.
# --allow-env  The 8 vars log_ingester.ts reads explicitly + the 7 PG*
#              vars `deno-postgres@v0.19.3` reads internally at Pool
#              construction time. log_ingester.ts:83 passes explicit
#              hostname/port/database/user/password to `new Pool(...)`,
#              but the driver still calls `Deno.env.get()` on the full
#              PG* family at construction (see `getPgEnv()` in the
#              driver's connection_params.ts). It catches the legacy
#              `Deno.errors.PermissionDenied`, but Deno 2.x raises
#              `Deno.errors.NotCapable` (the rename) — the catch
#              doesn't match and the error re-throws, crashing the
#              container at startup.
#              Earlier versions of this Dockerfile enumerated the full
#              mcp-container env list (~40 vars including MCP_ACCESS_KEY,
#              AUTH0_*, CHAT_API_KEY, OLLAMA_URL); those are STILL
#              excluded — log_ingester.ts deliberately does NOT import
#              config.ts (see comment at log_ingester.ts:33-37) so it
#              never touches those values. PG* values, even when read,
#              are only used as fallbacks when explicit Pool params are
#              undefined — which they aren't here — so allowing the
#              reads just lets the driver's try/catch see expected-empty
#              values without crashing.
# --allow-read   the access log dir (mounted :ro at the compose layer),
#                the cursor dir, and /app (the source tree). The ingester
#                is read-only on the actual .log files — defense in depth
#                so a compromise can't tamper with on-disk audit evidence.
#                Both dirs are derived from the same env vars the process
#                reads (CADDY_LOG_DIR, INGESTER_CURSOR_DIR) so an
#                override can't strand the container in a NotCapable loop
#                against the hard-coded defaults; overriding the cursor
#                dir still needs a writable mount at the new path.
#                A unix-socket DB_HOST is added to BOTH read and write:
#                Deno requires each separately for `Deno.connect({ transport:
#                "unix" })`, and the driver stats the directory before
#                appending `.s.PGSQL.<port>`. It is added only on the socket
#                branch, so a TCP deployment gains no filesystem reach.
# --allow-write  the cursor dir (plus a unix-socket DB_HOST, above). Cursor
#                files (<basename>.cursor)
#                live in a SEPARATE volume from the log files
#                (caddy_cursors, mounted RW only here): the ingester runs
#                as the non-root `deno` user and caddy creates the
#                root-owned log files in the caddy_logs volume, so
#                writing cursors there would fail with EACCES. The
#                default path is non-nested vs caddy_logs to avoid the
#                read-only-rootfs + nested-mountpoint init failure.
# `sh -c` wrapper so ${DB_HOST}/${DB_PORT} expand into the permission targets at
# start (exec-form CMD doesn't expand env); `exec` keeps deno as PID 1. The
# wrapper is the ENTRYPOINT and the entrypoint .ts is the CMD (forwarded as
# "$@"): keeps it overridable, and the --allow-env drift check
# (scripts/check_allow_env.ts) finds the quoted .ts in CMD. Defaults preserve
# the bundled-postgres behavior.
#
# THREE host shapes, one `case`, keeping every flag a self-contained
# `--opt=value` token (the drift check's parsing contract — see --allow-net
# above):
#   /*    unix socket            → dbHostType() in log_ingester.ts routes the
#         driver to `transport: "unix"`. Net grant names the socket FILE (both
#         spellings, see above); read+write cover the path. No TCP host.
#   *:*   IPv6 literal           → bracketed; Deno requires
#         `--allow-net=[::1]:5432` form.
#   *     hostname or IPv4       → the historical default.
ENTRYPOINT ["sh", "-c", "H=${DB_HOST:-postgres}; P=${DB_PORT:-5432}; L=${CADDY_LOG_DIR:-/var/log/caddy}; C=${INGESTER_CURSOR_DIR:-/var/lib/ingester/cursors}; case \"$H\" in /*) NET=\"unix:$H,unix:$H/.s.PGSQL.$P\"; RD=\"$L,$C,/app,$H\"; WR=\"$C,$H\" ;; *:*) NET=\"[$H]:$P\"; RD=\"$L,$C,/app\"; WR=\"$C\" ;; *) NET=\"$H:$P\"; RD=\"$L,$C,/app\"; WR=\"$C\" ;; esac; exec deno run --allow-net=\"$NET\" --allow-env=DB_HOST,DB_PORT,DB_NAME,DB_USER,DB_PASSWORD,CADDY_LOG_DIR,INGESTER_POLL_INTERVAL_MS,INGESTER_CURSOR_DIR,PGAPPNAME,PGDATABASE,PGHOST,PGOPTIONS,PGPASSWORD,PGPORT,PGUSER --allow-read=\"$RD\" --allow-write=\"$WR\" \"$@\"", "sh"]
CMD ["log_ingester.ts"]
