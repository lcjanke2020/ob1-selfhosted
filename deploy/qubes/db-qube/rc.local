#!/bin/sh
# DB qube boot tasks.
#
# Install at: /rw/config/rc.local   (chmod +x)
#
# Since the ConnectTCP cutover the cluster binds loopback only, so the old
# ordering constraint — wait for tailscale0 before starting Postgres — is
# gone, and with it the post-tailscale firewall one-shot (there is no network
# listener left to accept). What remains: start tailscaled (the node stays on
# the tailnet with ZERO inbound grants — drop this block if you retire the
# node entirely), then start the cluster.
#
# The manual start below assumes Debian's boot-time auto-start is OFF
# (/etc/postgresql/17/main/start.conf = `manual`, persisted by the
# /etc/postgresql bind-dir — see the README). With a loopback-only bind the
# stock auto-start would also work now; keeping the manual path preserves one
# explicit, logged start branch instead of two racing ones.

# All boot output goes to one per-boot log (ephemeral; /var/log is not
# bind-dir'd — fine for a boot probe).
LOG=/var/log/ob1-db-boot.log
exec >>"$LOG" 2>&1
echo "=== rc.local $(date -Is) ==="

# --- Tailscale (optional — node kept with zero inbound grants) ---
# The shared template keeps tailscaled DISABLED on purpose: when enabled in
# the template it broke the template's apt updates-proxy (tailscale0 is
# IPv6-only at that stage -> EAI_ADDRFAMILY). The AppVM starts it explicitly
# here instead.
systemctl start tailscaled

# --- Start Postgres (loopback-only listener; no interface wait) ---
# Capture and propagate the exit status: this is the single explicit start
# path, and a trailing echo would otherwise reset $? to 0 and mask a failed
# start behind a successful-looking boot. Exit 2 = "already running" — the
# cluster is UP but something started it first (start.conf left at `auto`
# instead of `manual`, or a manual operator start): report it truthfully as
# running, but flag the double-start-path drift instead of crying DOWN.
pg_ctlcluster 17 main start
rc=$?
case "$rc" in
0)
	echo "pg_ctlcluster exit=0 (cluster started)"
	;;
2)
	echo "WARNING: cluster was ALREADY RUNNING (pg_ctlcluster exit=2) — started outside rc.local; check /etc/postgresql/17/main/start.conf is 'manual' (README: Disable the cluster's boot auto-start)"
	rc=0
	;;
*)
	echo "ERROR: pg_ctlcluster 17 main start failed (exit=$rc) — the cluster is DOWN"
	;;
esac
exit "$rc"
