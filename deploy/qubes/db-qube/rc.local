#!/bin/sh
# DB qube boot tasks.
#
# Install at: /rw/config/rc.local   (chmod +x)
#
# Since the ConnectTCP cutover the cluster binds loopback only, so the old
# ordering constraint — wait for tailscale0 before starting Postgres — is
# gone, and with it the post-tailscale firewall one-shot (there is no network
# listener left to accept). What remains: start tailscaled (the node stays on
# the tailnet with ZERO inbound grants — drop this block if you retire the
# node entirely), then start the cluster.
#
# The manual start below assumes Debian's boot-time auto-start is OFF
# (/etc/postgresql/17/main/start.conf = `manual`, persisted by the
# /etc/postgresql bind-dir — see the README). With a loopback-only bind the
# stock auto-start would also work now; keeping the manual path preserves one
# explicit, logged start branch instead of two racing ones.

# All boot output goes to one per-boot log (ephemeral; /var/log is not
# bind-dir'd — fine for a boot probe).
LOG=/var/log/ob1-db-boot.log
exec >>"$LOG" 2>&1
echo "=== rc.local $(date -Is) ==="

# --- Tailscale (optional — node kept with zero inbound grants) ---
# The shared template keeps tailscaled DISABLED on purpose: when enabled in
# the template it broke the template's apt updates-proxy (tailscale0 is
# IPv6-only at that stage -> EAI_ADDRFAMILY). The AppVM starts it explicitly
# here instead.
systemctl start tailscaled

# --- Start Postgres (loopback-only listener; no interface wait) ---
# This is the single explicit start path, and its exit status is rc.local's:
# a failed start must fail the boot visibly. Detecting "already running"
# needs care in THIS context: as root under systemd, Debian's pg_ctlcluster
# redirects `start` to `systemctl start postgresql@17-main` and returns ITS
# status — an already-active unit start is idempotent exit 0 (no exit 2 to
# catch), and a postmaster started outside the unit makes the redirected
# start FAIL while the cluster is genuinely up. So: detect already-running
# with a status preflight (`pg_ctlcluster status` is not redirected), and
# after a failed start re-check actual state before declaring the cluster
# down — DOWN must mean confirmed-stopped, or the ERROR path stops meaning
# anything.
if pg_ctlcluster 17 main status >/dev/null 2>&1; then
	echo "WARNING: cluster was ALREADY RUNNING before rc.local's start — started outside this script; check /etc/postgresql/17/main/start.conf is 'manual' (README: Disable the cluster's boot auto-start)"
	exit 0
fi
pg_ctlcluster 17 main start
rc=$?
if [ "$rc" -eq 0 ]; then
	echo "pg_ctlcluster exit=0 (cluster started)"
	exit 0
fi
if pg_ctlcluster 17 main status >/dev/null 2>&1; then
	echo "WARNING: start returned exit=$rc but the cluster IS running — a racing start path won; check /etc/postgresql/17/main/start.conf is 'manual' (README: Disable the cluster's boot auto-start)"
	exit 0
fi
echo "ERROR: pg_ctlcluster 17 main start failed (exit=$rc) — the cluster is DOWN (confirmed stopped)"
exit "$rc"
