[Unit]
# Applies /rw/config/qubes-firewall-user-script (the custom-input accepts)
# once tailscaled is up, so the tailscale0-scoped rules land on the running
# interface. On an app qube that doesn't route other qubes the qubes-firewall
# service's own hook never fires — this one-shot IS the applier. rc.local
# restages + enables it each boot (/etc/systemd/system is wiped on every AppVM
# reboot, so it cannot be enabled persistently in place).
#
# Stash at: /rw/config/ob1-app-firewall.service
#
# (An earlier revision of this unit also waited on docker + the DOCKER-USER
# chain to scope mcp's 0.0.0.0:8787 publish. That listener is gone — mcp binds
# loopback and the ingress qube arrives over qubes.ConnectTCP — so the unit no
# longer orders against docker at all.)
Description=OB1 app qube host firewall (custom-input rules, after tailscale)
After=tailscaled.service
Wants=tailscaled.service

[Service]
Type=oneshot
ExecStart=/rw/config/qubes-firewall-user-script
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
