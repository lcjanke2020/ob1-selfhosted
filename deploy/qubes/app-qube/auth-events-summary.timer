# systemd USER unit — install at ~/.config/systemd/user/auth-events-summary.timer on
# the app qube. User lingering is required to run without an open login session.
[Unit]
Description=Run Open Brain auth-event summary daily

[Timer]
# UTC matches the SQL's day boundaries and leaves the prior day complete.
OnCalendar=*-*-* 00:30:00 UTC
AccuracySec=1min
# A suspended qube fires a slept-through occurrence late on wake on its own (the
# active OnCalendar= timer, no stamp involved). Persistent=true covers the case
# the timer was INACTIVE — a qube reboot — so a rebooted night does not become
# an unbounded retention gap; as a USER unit its stamp lives in the persistent
# home, so this works across reboots without any bind-dir.
Persistent=true

[Install]
WantedBy=timers.target
