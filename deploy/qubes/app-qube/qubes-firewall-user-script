#!/bin/sh
# App qube host firewall — custom-input accepts for host-side services.
#
# Install at: /rw/config/qubes-firewall-user-script   (chmod +x)
#
# HOW THIS RUNS: on an app qube that doesn't route other qubes, the
# qubes-firewall service's own hook never fires (its unit condition doesn't
# hold), so this script would sit unexecuted. rc.local therefore installs a
# one-shot unit (ob1-app-firewall.service) whose ExecStart IS this script,
# ordered After=tailscaled so the tailscale0-scoped rules below land on the
# running interface. Same pattern as the db qube's firewall unit.
#
# The qubes nft `input` chain default-drops, so only what you add here is
# reachable. Loopback is accepted by the stock chain — that detail is
# load-bearing for both forwarder transports (see the NOTE at the bottom).
#
# Idempotent + logged (same shape as the db qube's script): re-running (the
# one-shot, a manual run) won't stack duplicate accepts, and a failed add
# (nft layout can drift across Qubes versions) is visible in $LOG instead of
# silently dropping a layer. Pre-flight check:
#   nft list ruleset | grep custom-input

LOG=/var/log/ob1-app-firewall.log

add_rule() {
	fam=$1
	proto=$2
	port=$3
	label=$4
	if nft list chain "$fam" qubes custom-input 2>/dev/null \
		| grep -q "iifname \"tailscale0\" $proto dport $port ct state new accept"; then
		echo "$(date -Is) [$fam] tailscale0:$port/$proto ($label) already present; skipping" >>"$LOG"
		return 0
	fi
	if nft add rule "$fam" qubes custom-input \
		iifname "tailscale0" "$proto" dport "$port" ct state new accept 2>>"$LOG"; then
		echo "$(date -Is) [$fam] added tailscale0:$port/$proto accept ($label)" >>"$LOG"
	else
		echo "$(date -Is) [$fam] FAILED to add tailscale0:$port/$proto ($label) — chain/table missing? check: nft list ruleset | grep custom-input" >>"$LOG"
	fi
}

# Remote admin over the tailnet. Remove if you administer via dom0 qvm-run only.
add_rule ip tcp 22 ssh
add_rule ip6 tcp 22 ssh

# Optional — if your encrypted-backup replication (see backup/) runs Syncthing
# on this qube, accept it on tailscale0 only:
#   add_rule ip  tcp 22000 syncthing
#   add_rule ip6 tcp 22000 syncthing
#   add_rule ip  udp 22000 syncthing
#   add_rule ip6 udp 22000 syncthing

# NOTE: two rule sets earlier revisions of this deployment carried are
# deliberately GONE:
#
#  - The `br-*` → :11434 accept (the GPU-offload forwarder's old transport):
#    under ROOTLESS docker the compose bridge lives inside rootlesskit's
#    network namespace, and container → host traffic arrives on lo, which the
#    qubes input chain already accepts. The forwarder now binds the qube's own
#    IP instead of a bridge gateway (see ../gpu-offload-transport.md).
#
#  - The DOCKER-USER machinery that scoped mcp's old 0.0.0.0:8787 publish
#    (an iptables DOCKER-USER insert script + a docker.service drop-in + a
#    boot one-shot): mcp now publishes 127.0.0.1 only and the ingress qube
#    reaches it over qubes.ConnectTCP (dom0 policy gates the channel), so
#    there is no network listener to scope. Nothing listens on eth0 or
#    tailscale0, and the input default-drop covers every unlisted port.

exit 0
