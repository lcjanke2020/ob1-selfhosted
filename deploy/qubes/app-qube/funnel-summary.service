# systemd USER unit — install at ~/.config/systemd/user/funnel-summary.service
# on the app qube. The wrapper loads ~/.config/funnel-summary.env itself so the
# same command works both under systemd and during manual verification.
[Unit]
Description=Open Brain daily Funnel summary and retention

[Service]
Type=oneshot
Environment=FUNNEL_SUMMARY_ENV_FILE=%h/.config/funnel-summary.env
ExecStart=/usr/bin/bash %h/funnel_daily_summary.sh
UMask=0077
# A timeout before COMMIT aborts psql's open transaction; report staging always
# preserves the last complete artifact. Initial backlog catch-up should finish
# well inside this bound; increase it with a local drop-in for an unusually
# large deployment.
TimeoutStartSec=30min
