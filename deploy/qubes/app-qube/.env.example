# app qube .env — copy to .env and fill in.
#   cp .env.example .env && $EDITOR .env
#
# This is the per-qube credential split for the APP qube of the three-qube
# topology. The app qube is the trusted compartment and DB control-plane, so it
# DOES hold the admin/superuser password (unlike the internet-adjacent ingress
# qube, which holds only the INSERT-only ingester credential). It never holds
# the ingester credential.

# ---------- Database (canonical Postgres on the dedicated DB qube) ----------

# Database name (default openbrain).
POSTGRES_DB=openbrain

# The canonical Postgres lives on the dedicated DB qube. MANDATORY here — this
# qube runs no local postgres. Set to the db qube's tailnet address.
#   DB_HOST=<db-qube-tailnet-ip>
DB_HOST=
DB_PORT=5432

# Admin/superuser password for the db qube's cluster, held on this qube (the
# trusted compartment — never on the internet-adjacent ingress qube) and used to
# administer the db qube REMOTELY over the tailnet: role provisioning +
# schema/migrations (db/00-roles.sh, db/01-schema.sql, later numbered SQL,
# scripts/upgrade-add-ingester-role.sh). The db-qube pg_hba grants the superuser
# a host line from THIS qube's IP only — a deliberate trade-off (see
# deploy/qubes/db-qube/). mcp does NOT connect as this user; it uses openbrain_app.
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Application role the MCP server connects as — scoped thought/session access,
# append-only metadata-degradation audit access, notification-ledger update, and
# observability-rollup DML. This is the role that "writes thoughts." The host-side
# daily summary copies this value into its narrower 0600 funnel-summary.env; it
# does not source this whole compose environment.
# generate: openssl rand -hex 24
OPENBRAIN_APP_PASSWORD=

# Read-only role (SELECT only). Used by the encrypted backup job in backup/
# (pg_dump against the db qube) and for ad-hoc inspection.
# generate: openssl rand -hex 24
OPENBRAIN_READONLY_PASSWORD=

# NOTE: there is intentionally no OPENBRAIN_INGESTER_PASSWORD here — the
# log-ingester runs on the ingress qube, which is the only qube that holds it.

# ---------- Embeddings (Ollama, CPU-only in this qube) ---------------------

# Local in-compose ollama by default. Point at an external GPU box to offload:
#   OLLAMA_URL=http://gpubox.tailnet-name.ts.net:11434
OLLAMA_URL=http://ollama:11434

# nomic-embed-text → 768. mxbai-embed-large → 1024. If you change this, also
# update vector(N) in db/01-schema.sql to match (re-run on the db qube).
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ---------- Optional: metadata extraction via chat LLM ---------------------
# Classify each captured thought (type/topics/people/...) with any
# OpenAI-compatible /chat/completions endpoint. Two slots: a PRIMARY and an
# optional FALLBACK. Leave BOTH blank to disable extraction entirely (capture
# still works; metadata defaults to {topics:[uncategorized]}).
#
# PRIMARY endpoint — your local-first classifier (content stays on your network,
# zero marginal cost). Point it at an OpenAI-compatible box on your LAN/tailnet,
# e.g. LM Studio or ollama:
#   CHAT_API_BASE=http://<gpu-box>.<tailnet-name>.ts.net:1234/v1  # LM Studio
#   CHAT_MODEL=<your-served-model>     # CHAT_API_KEY blank if the server needs none
# A Qubes app qube has no GPU. To offload to a GPU *qube* on the same host
# instead, reach its loopback-only server via the host-side ConnectTCP
# forwarder bound to THIS qube's own IP (`qubesdb-read /qubes-ip`; see
# ../gpu-offload-transport.md — under rootless docker the container reaches
# its own host at that address):
#   CHAT_API_BASE=http://<qube-ip>:11434/v1
CHAT_API_BASE=
CHAT_API_KEY=
CHAT_MODEL=
# CHAT_TIMEOUT_MS=60000

# Safety gate for the PRIMARY (CHAT_*) call — opt-in, OFF by default. You MUST
# set this EXACTLY to "true" (and configure CHAT_* above) to use the primary;
# otherwise extraction skips it and follows METADATA_FALLBACK_POLICY below.
# Leave off until the primary endpoint is verified reachable + safe (e.g. don't
# enable a primary fronted by a transport that could disturb other infra).
# ENABLE_PRIMARY_EXTRACTION=true

# FALLBACK endpoint — available under the explicit `alert` or `allow` policy
# when the PRIMARY is disabled or fails. It also works on its own: a fallback-
# only deployment (CHAT_* blank) classifies every capture here. Under `off`,
# these variables stay inert even when populated. Leave blank to make every
# policy use the local stub after primary failure.
#   FALLBACK_CHAT_API_BASE=https://api.openai.com/v1
#   FALLBACK_CHAT_MODEL=gpt-5.4-mini
# NOTE: when the policy permits this path, it can send thought content OFF your
# network. A fallback-only deployment then routes EVERY capture here, and the
# server logs each use.
FALLBACK_CHAT_API_BASE=
FALLBACK_CHAT_API_KEY=
FALLBACK_CHAT_MODEL=

# REQUIRED privacy policy; there is no default and the server refuses to boot
# until you choose explicitly:
#   off   — never call FALLBACK_CHAT_*; a primary failure stores the local stub.
#   alert — call the fallback and require a configured notification channel.
#           Boot validates adapter config, not provider reachability; delivery
#           stays best-effort, so live-fire it before relying on alerts.
#   allow — call the fallback without requiring delivery (privacy-weakest).
# `alert` and `allow` also preserve fallback-only deployments (CHAT_* blank).
METADATA_FALLBACK_POLICY=

# ---------- Optional: durable metadata-degradation alerts ---------------
# Real degradation rows are always written; intentionally disabled extraction,
# including a fallback suppressed by policy `off`, emits none. Set one or both
# comma-separated channels for content-free first-occurrence alerts plus
# 30-minute rollups. Two channels are best-effort fan-out, not independent
# guaranteed delivery; one provider success commits the
# batch. Blank disables delivery but retains degradation events in the durable
# queue for later enablement or explicit owner discard. This server-side worker
# supersedes log scraping once it has been deployed and live-fired successfully.
#
# Use a generic label — it is the only deployment identity in the payload, so
# never put a hostname/address/topology detail here. Keep this real .env 0600;
# the Pushover values, ntfy token, and an unguessable ntfy topic are secrets.
METADATA_NOTIFY_CHANNELS=
METADATA_NOTIFY_LABEL=OpenBrain
# METADATA_NOTIFY_POLL_INTERVAL_MS=300000
# METADATA_NOTIFY_ROLLUP_MS=1800000
# METADATA_NOTIFY_TIMEOUT_MS=10000

METADATA_PUSHOVER_APP_TOKEN=
METADATA_PUSHOVER_USER_KEY=

METADATA_NTFY_SERVER_URL=https://ntfy.sh
METADATA_NTFY_TOPIC=
METADATA_NTFY_TOKEN=

# ---------- MCP server -----------------------------------------------------

# Omitted scope resolves to exactly this registered workspace. OAuth subjects
# provide personal identity automatically; no shared-key principal is used.
DEFAULT_WORKSPACE_ID=default

# This Qubes deployment authenticates with Auth0/OAuth ONLY. There is NO
# x-brain-key door here: compose pins native-token verification false and
# MCP_ACCESS_KEY is intentionally omitted, so a leaked native/static credential
# cannot be used against this publicly reachable install.

# Citation URL base for the search/fetch tools. Optional (informational URL).
#   CITATION_BASE_URL=https://homebox.tailnet-name.ts.net/thoughts
CITATION_BASE_URL=

# ---------- Auth0 OAuth resource server (REQUIRED) -------------------------
# REQUIRED — this is the only auth door for the Qubes deployment. All three
# must be set or the server refuses to start (partial config also throws). The
# ingress qube's Caddy fronts the OAuth/Funnel door and enforces the Anthropic
# IP allowlist. See compose-local/.env.example for the Auth0 dashboard setup.
AUTH0_ISSUER=
AUTH0_JWKS_URI=
AUTH0_AUDIENCE=
# Optional comma-separated exact JWT subjects for service accounts whose token
# profile has no signed gty=client-credentials claim. This includes Auth0's RFC
# 9068 profile; Auth0's default profile needs no entry. Attribution only. See
# ../../../docs/service-account-oauth-client.md.
OAUTH_SERVICE_ACCOUNT_SUBJECTS=
# JWKS_FETCH_TIMEOUT_MS=10000

# ---------- Optional: mcp tunables (defaults mirror the code) --------------
# OBS_AUTH_EVENTS_ENABLED=true
# OBS_AUTH_EVENTS_MAX_IN_FLIGHT=500
# AUTH_BODY_READ_TIMEOUT_MS=2000

# ---------- Encrypted backup ----------------------------------------------
# The daily encrypted DB backup job has its OWN env file so it can be sourced
# in isolation by the systemd unit — see backup/backup.env.example.
