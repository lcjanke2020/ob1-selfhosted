# Funnel summary backup config — install as
# /rw/config/openbrain-units/funnel-summary-backup.env (mode 0640).
# This file contains no database password and no private encryption key.

# The ingress qube's dom0 identity, which may differ from its DNS hostname.
TARGET_QUBE=<ingress-qube>

# Reuse the canonical corpus backup's encrypt-only public key and
# off-box-replicated destination.
PUBKEY=/rw/config/openbrain-units/backup-pubkey.asc
OUT_DIR=/home/user/sync/ob1-db-backups

# Keep fourteen nightly snapshots of the rolling 365-day summary table.
RETAIN_DAYS=14

# Hostile-source bounds. The current summary dump is only a few KiB; 64 MiB
# leaves ample schema/data growth while bounding disk and vchan consumption.
MIN_DUMP_BYTES=1024
MAX_DUMP_BYTES=67108864
TIMEOUT_SECONDS=300

# Installed helper path; normally leave unchanged.
BOUNDED_STREAM=/rw/config/openbrain-units/ob1-bounded-stream.py
