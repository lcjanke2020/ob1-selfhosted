# Daily funnel-rollup config — install at ~/.config/funnel-summary.env, mode 0600.
#   mkdir -p ~/.config
#   cp funnel-summary.env.example ~/.config/funnel-summary.env
#   chmod 0600 ~/.config/funnel-summary.env && $EDITOR ~/.config/funnel-summary.env
#
# Sourced only by scripts/funnel_daily_summary.sh, which rejects symlinks,
# non-owned files, and any group/other permission bits. Keep this separate from
# the app compose .env: the rollup needs one app-role password, not the admin,
# OAuth, model-provider, and notification secrets in the full environment.
#
# THIS IS THE AUTH-EVENTS HALF of the rollup. mcp writes mcp_auth_events into
# the corpus, so its retention and report run here. The FUNNEL access log no
# longer lives in this database — it is written to a local sink on the ingress
# qube, which runs the other half; see
# ../ingress-qube/funnel-summary.env.example.

# The canonical Postgres is remote in the three-qube split. The file is sourced
# by bash, so DB_HOST stays empty instead of using a shell-significant
# <angle-bracket> placeholder.
SUMMARY_BACKEND=postgres
DB_HOST=
DB_PORT=5432
POSTGRES_DB=openbrain

# Existing least-privilege application role. It has the DML needed to retire
# observability rows but cannot delete thoughts. Copy the same value used for
# OPENBRAIN_APP_PASSWORD in the app compose .env. (SUMMARY_ROLE defaults to
# openbrain_app and SUMMARY_ROLE_PASSWORD defaults to this variable, so neither
# needs setting here.)
OPENBRAIN_APP_PASSWORD=

# Only the auth-events half. Leaving this unset would run BOTH shipped SQL
# files — the single-host default — and the funnel half would then operate on
# the stale, now-unwritten funnel_access_log left in this database, producing an
# empty report section and a pointless retention DELETE.
SUMMARY_SQL_FILE="$HOME/summarize_auth_events.sql"

# The install recipe copies the SQL next to the wrapper. These defaults need no
# edits for that layout. Reports stay local and private by default because they
# contain request metadata; point SUMMARY_DIR at a trusted replicated directory
# only when that destination has an appropriate privacy posture. For Syncthing,
# add `/.funnel-summary-*` to that folder's .stignore so a staging file left by
# an uncatchable hard kill or qube crash never replicates.
SUMMARY_DIR="$HOME/openbrain-funnel-summaries"

# Bound only the network handshake; the service unit separately caps the whole
# rollup at 30 minutes so a killed psql transaction rolls back cleanly.
PGCONNECT_TIMEOUT=10
