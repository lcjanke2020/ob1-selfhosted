# Funnel-monitor configuration — install at ~/.config/funnel-monitor.env, chmod 0600.
#   mkdir -p ~/.config
#   cp funnel-monitor.env.example ~/.config/funnel-monitor.env
#   chmod 0600 ~/.config/funnel-monitor.env && $EDITOR ~/.config/funnel-monitor.env
#
# Read by scripts/funnel_monitor.sh (host-side, NOT compose — deliberately
# separate from this directory's .env so the monitor credential never enters
# a container environment).

# The db qube (canonical Postgres) — same address as DB_HOST in .env.
# The file is sourced by bash, so the value stays empty rather than an
# <angle-bracket> placeholder (which would be a shell syntax error).
#   DB_HOST=<db-qube-tailnet-ip>
DB_HOST=
DB_PORT=5432
POSTGRES_DB=openbrain

# SELECT-only metadata role (funnel_access_log only; no mcp_auth_events or
# thoughts — created by db/00-roles.sh when OPENBRAIN_MONITOR_PASSWORD is set, or
# by scripts/upgrade-add-monitor-role.sh on an existing DB). The db qube's
# pg_hba must permit openbrain_monitor from THIS qube's tailnet IP.
# generate: openssl rand -hex 24
OPENBRAIN_MONITOR_PASSWORD=

# Alert threshold for funnel request volume per 5-minute window (default 200).
# VOLUME_THRESHOLD=200

# Optional privacy-safe Pushover notification for bursts of HTTP 401 responses
# at the public Funnel door. Delivery is OFF until explicitly enabled, so an
# upgrade preserves the existing local-log-only monitor. Before setting this
# to 1, install the two separate 0600 files described in ingress-qube/README.md
# and verify this qube can reach https://api.pushover.net.
PUSHOVER_ENABLED=0

# A successful monitor interval with at least this many newly ingested Funnel
# 401 rows is a burst. The first qualifying interval pushes immediately;
# further qualifying intervals accumulate into periodic rollups.
# AUTH_FAILURE_BURST_THRESHOLD=5

# Minimum seconds between aggregate pushes during continued activity.
# Accepted range: 60..604800 (default 1800 = 30 minutes).
# PUSHOVER_ROLLUP_SECONDS=1800

# Provider-visible deployment label. Keep it generic: never use a machine,
# qube, container, customer, or environment name. Allowed: 1-32 letters,
# digits, underscores, and hyphens.
# OB1_MONITOR_LABEL=ob1
