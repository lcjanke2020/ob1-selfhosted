# ingress qube .env — copy to .env and fill in.
#   cp .env.example .env && $EDITOR .env
#
# Per-qube credential split for the INGRESS (public-edge) qube. This qube is
# internet-adjacent, so it holds the MINIMUM: the upstream address plus the
# credentials for its OWN local log sink — a Postgres holding request metadata
# and nothing else. It must NOT carry the superuser (POSTGRES_PASSWORD) or app
# (OPENBRAIN_APP_PASSWORD) password, and it no longer holds any address or
# credential for the db qube at all: nothing on this qube connects there.
#
# Note there is deliberately no variable here whose name contains APP. The
# sink's rollup credential is OPENBRAIN_LOGS_ROLLUP_PASSWORD so that a secret
# on the internet-facing qube can never be confused with — or copy-pasted
# from — an app-role secret.

# ---------- Compose project ------------------------------------------------

# Pins the compose project identity so every `docker compose`
# exec/logs/ps/down run beside this file resolves the same stack regardless
# of invocation shape (same convention as deploy/compose-local's pin).
# Adopting this line on an already-running qube? Read
# deploy/compose-tailnet/README.md §"Upgrading an existing deployment" first —
# changing the project name of a live stack orphans its containers.
COMPOSE_PROJECT_NAME=openbrain-ingress

# ---------- Caddy upstream (the app qube's mcp, via qubes.ConnectTCP) ------

# MANDATORY. Caddy reverse-proxies to the app qube's mcp through a host-side
# socat forwarder (ob1-mcp-forward.sh in this directory) that rides a
# dom0-policy-gated qubes.ConnectTCP channel — the app qube has NO
# network-facing mcp listener. Set this to THIS qube's own IP
# (`qubesdb-read /qubes-ip`) and the forwarder port; under the deployed
# rootless docker the caddy container reaches its own host's IP via
# slirp4netns:
#   MCP_UPSTREAM=<this-qube-ip>:18787
# Rollback to the earlier direct-tailnet upstream: point this line at
# <app-qube-tailnet-ip>:8787, republish mcp on 0.0.0.0 in the app-qube
# compose, AND add an ingress-scoped custom-input accept there (a rootless
# publish is governed by the qubes input default-drop) — full recipe in
# README.md § The ingress→app hop.
MCP_UPSTREAM=

# ---------- Local log sink (this qube's own Postgres) ----------------------
# Unix socket only: no published port, no container network, and
# `listen_addresses=` empty. See README.md § Local log sink.

# Sink database name (default openbrain_logs). Deliberately NOT `openbrain` —
# a distinct name makes it obvious in any psql prompt or log line that this is
# the edge's metadata store and not the corpus.
LOG_SINK_DB=openbrain_logs

# HOST directory for the sink's unix socket, shared by the two containers and
# by the host-side monitor + rollup. MANDATORY.
#
# KEEP IT SHORT — a unix socket path is capped at 107 bytes (sun_path) and it
# is this HOST path that the host-side clients use. A deep path fails at
# connect time with "Unix-domain socket path ... is too long", not at mount
# time. Create it before the first `up`:
#   install -d -m 0755 ~/ob1-log-sink/run
# (No chown needed: the postgres entrypoint takes ownership of this directory
# on every start, which under rootless docker lands on a subuid while leaving
# it traversable by your account.)
LOG_SINK_SOCKET_DIR=/home/user/ob1-log-sink/run

# CONTAINER-side socket directory for the ingester. An absolute path is what
# selects the unix transport (see server/log_ingester.ts dbHostType). This is a
# fixed in-container path — leave it as-is.
INGESTER_DB_HOST=/var/run/postgresql
DB_PORT=5432

# Sink superuser, reserved for trusted administration: init, adoption, upgrades,
# and explicit assertions. No long-running client service receives it. Socket
# connections require scram — the sink overrides the postgres image's default
# `local all all trust`, which would otherwise let anything reaching the socket
# in as any role without a password — so this must be non-empty or init fails.
# generate: openssl rand -hex 24
LOG_SINK_SUPERUSER_PASSWORD=
# LOG_SINK_SUPERUSER=postgres

# The sink reuses the corpus's retired role NAMES (openbrain_ingester,
# openbrain_monitor) by design — never reuse those roles' old corpus
# passwords here. Fresh values keep any credential that left the edge before
# the cutover dead; the corpus-side retirement pass is
# deploy/qubes/db-qube/README.md § Retiring the ingress qube's old access.

# INSERT-only observability role the log-ingester connects as. Required.
# generate: openssl rand -hex 24
OPENBRAIN_INGESTER_PASSWORD=

# The daily summary + retention role (host-side timer; see
# funnel-summary.env.example). DML on the two observability tables, nothing
# else. Required — the sink's init creates it unconditionally.
# generate: openssl rand -hex 24
OPENBRAIN_LOGS_ROLLUP_PASSWORD=

# SELECT-only role for the host-side funnel monitor. OPTIONAL: leave unset and
# the sink creates no monitor role and grants nothing. If you DO run the
# monitor, set the SAME value here and in ~/.config/funnel-monitor.env — this
# compose env is what creates the role; that file is what the monitor
# authenticates with. (It is listed here, unlike in the pre-sink layout, only
# because role creation happens in this qube's own database now.)
# generate: openssl rand -hex 24
OPENBRAIN_MONITOR_PASSWORD=

# SELECT-only role for the optional qrexec summary-backup service. It can read
# funnel_access_summary and nothing else — in particular, not raw IP or
# user-agent rows. Set a fresh value only when installing that service.
# generate: openssl rand -hex 24
OPENBRAIN_LOGS_BACKUP_PASSWORD=

# How often the ingester polls the Caddy access logs (ms, default 5000).
# INGESTER_POLL_INTERVAL_MS=5000

# ---------- Funnel wiring (host, not compose) ------------------------------
# After `docker compose up -d`, expose Caddy publicly with a single rule:
#   sudo tailscale serve  --https=443 off                          # vacate :443
#   sudo tailscale funnel --bg --https=443 http://127.0.0.1:9787   # single rule
# Funnel must also be enabled for this device in the Tailscale admin console.

# ---------- What is NOT here (and must not be added) -----------------------
# DB_HOST — there is no db-qube address on this qube any more. The ingester
#   writes locally; the monitor and rollup read locally. If you find yourself
#   reintroducing a db-qube address here, that is the change this topology
#   exists to prevent.
# POSTGRES_PASSWORD / OPENBRAIN_APP_PASSWORD / OPENBRAIN_READONLY_PASSWORD —
#   corpus credentials. They belong on the app qube only.
