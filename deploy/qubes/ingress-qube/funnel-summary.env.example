# Daily funnel-rollup config for the INGRESS qube — install at
# ~/.config/funnel-summary.env, mode 0600.
#   mkdir -p ~/.config
#   cp funnel-summary.env.example ~/.config/funnel-summary.env
#   chmod 0600 ~/.config/funnel-summary.env && $EDITOR ~/.config/funnel-summary.env
#
# Sourced only by scripts/funnel_daily_summary.sh, which rejects symlinks,
# non-owned files, and any group/other permission bits.
#
# THIS IS THE SINK'S HALF of the rollup. The Funnel access log lives here now,
# so its daily summary and its 30-day retention run here too — against the
# local sink, over its unix socket. The app qube runs the OTHER half
# (mcp_auth_events) against the corpus; see
# ../app-qube/funnel-summary.env.example. Neither qube can see the other's
# tables, which is the point.

SUMMARY_BACKEND=postgres

# The local sink's unix socket DIRECTORY — the same host path as
# LOG_SINK_SOCKET_DIR in .env and DB_HOST in funnel-monitor.env. An absolute
# path makes psql use a socket rather than TCP; the sink has no TCP listener to
# fall back on. Keep it short (107-byte sun_path limit, including
# /.s.PGSQL.5432).
DB_HOST=/home/user/ob1-log-sink/run
DB_PORT=5432
POSTGRES_DB=openbrain_logs

# Only the funnel half. The mcp_auth_events half needs the corpus, which this
# qube deliberately cannot reach — pointing this at both files would fail on
# the missing table. Adjust the path if you installed from a checkout rather
# than the side-by-side $HOME layout below.
SUMMARY_SQL_FILE="$HOME/summarize_funnel.sql"

# The sink's DML role. NOT openbrain_app — that role belongs to the corpus, and
# no secret on this qube should share its name. See
# db/log-sink/00-log-sink-roles.sh.
SUMMARY_ROLE=openbrain_logs_rollup

# Same value as OPENBRAIN_LOGS_ROLLUP_PASSWORD in the compose .env, which is
# where the role is actually created.
# generate: openssl rand -hex 24
SUMMARY_ROLE_PASSWORD=

# Reports contain request metadata (client IPs, paths, user-agents), so they
# stay in a local mode-0700 directory by default. Point SUMMARY_DIR at a
# replicated directory only if that destination has an appropriate privacy
# posture — and note that replicating FROM this qube is a new outbound path off
# the perimeter, which the sink's disposable-data posture deliberately avoids.
# For Syncthing, add `/.funnel-summary-*` to that folder's .stignore so a
# staging file left by a hard kill or qube crash never replicates.
SUMMARY_DIR="$HOME/openbrain-funnel-summaries"

# Bounds the connection handshake. Local and effectively instant over a socket;
# kept for parity with the app qube's file and as a guard against a wedged
# sink. The service unit separately caps the whole rollup at 30 minutes.
PGCONNECT_TIMEOUT=10
